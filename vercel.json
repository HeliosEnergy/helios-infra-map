{
  "rewrites": [
    {
      "source": "/api/wfs/(.*)",
      "destination": "/api/wfs/[...path].ts"
    },
    {
      "source": "/itu-proxy/(.*)",
      "destination": "/api/wfs/[...path].ts"
    }
  ],
  "functions": {
    "api/public-contacts.ts": {
      "maxDuration": 300
    },
    "api/**/*.ts": {
      "maxDuration": 30
    }
  }
}
